{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/src/**",
          "backend/prisma/**",
          "backend/node_modules/.prisma/client/**",
          "backend/node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "/backend/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}