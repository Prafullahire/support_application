{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/dist/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/src/**",
          "backend/prisma/**",
          "backend/node_modules/.prisma/client/**",
          "backend/node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": "/backend/dist/api/index.js"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/backend/dist/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}